# Copy to infra/.env on the server and fill in. infra/.env is git-ignored: secrets never go in git.
API_HOST=api.example.org
MC_HOST=mc.example.org
ASSETS_HOST=assets.example.org
# The deployed web app (Vercel or Netlify). Comma-separated for planner/mission-control CORS;
# the assets host takes exactly one origin.
WEB_ORIGIN=https://ariadne.example.app
# Folder that holds bright-angel/ (assets_base). Planner reads DATA_DIR/bright-angel/...
ASSETS_DIR=/srv/assets
# api.nasa.gov key for DONKI (task M4).
NASA_API_KEY=
