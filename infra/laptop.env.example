# Copy to infra/.env.laptop (git-ignored: .env.*) for laptop hosting behind Tailscale Funnel (infra/funnel.sh).
# Caddy serves plain HTTP on loopback ports; Funnel adds HTTPS on the tailnet name.
ASSETS_HOST=http://:8090
# Unused on the laptop (planner and mission-control are funnelled directly), but Caddy needs a value;
# plain-HTTP ports keep it from asking for certificates.
API_HOST=http://:8091
MC_HOST=http://:8092
# The deployed web app. One origin only: the assets host sends it as Access-Control-Allow-Origin.
WEB_ORIGIN=https://ariadne-gilt-tau.vercel.app
# Folder that holds the assets. contracts/fixtures is SYNTHETIC; point this at the real DATA_DIR
# (with bright-angel/ and aoi.json) once the pipeline output is on this laptop.
ASSETS_DIR=../contracts/fixtures
# api.nasa.gov key for DONKI (task M4). Fill in by hand; never commit it.
NASA_API_KEY=
