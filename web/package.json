{
  "name": "ariadne-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:lan": "vite --host",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "oxlint",
    "test": "vitest run",
    "gen:types": "openapi-typescript ../contracts/openapi.yaml --root-types --root-types-no-schema-prefix -o src/lib/types.ts",
    "check": "npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "@deck.gl/core": "^9.4.1",
    "@deck.gl/layers": "^9.4.1",
    "@deck.gl/mesh-layers": "^9.4.1",
    "@deck.gl/react": "^9.4.1",
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "uqr": "^0.1.3",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^31.0.1",
    "openapi-typescript": "^7.13.0",
    "oxlint": "^1.90.0",
    "typescript": "~5.9",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
